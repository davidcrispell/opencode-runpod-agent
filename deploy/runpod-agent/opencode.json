{
  "$schema": "https://opencode.ai/config.json",
  "model": "runpod-local/runpod-model",
  "update": "disable",
  "share": "disabled",
  "websearch": false,
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "runpod-local",
      "effect": "allow"
    }
  ],
  "providers": {
    "runpod-local": {
      "name": "Runpod local llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:LLAMA_API_KEY}",
        "timeout": 1800000,
        "headerTimeout": 1800000,
        "chunkTimeout": 300000
      },
      "models": {
        "runpod-model": {
          "name": "Runpod model",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset *",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    }
  ]
}
